<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.saj.ads.poo.IngressoController">
   <children>
      <AnchorPane layoutX="-1.0" layoutY="-1.0" prefHeight="60.0" prefWidth="607.0" style="-fx-background-color: #4CAF50;" />
      <Label alignment="CENTER" layoutX="173.0" text="Cadastro de Integrantes" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="10.0">
         <font>
            <Font size="28.0" />
         </font>
      </Label>
      <TabPane layoutX="14.0" layoutY="70.0" prefHeight="280.0" prefWidth="572.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="70.0">
        <tabs>
          <Tab text="Professor">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <VBox layoutX="14.0" layoutY="14.0" spacing="15.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
                           <children>
                              <Label text="Nome Completo:" />
                              <TextField fx:id="txNomeProfessor" prefHeight="25.0" prefWidth="544.0" />
                              <Label text="Matrícula" />
                              <TextField fx:id="txMatriculaProfessor" prefHeight="25.0" prefWidth="544.0" />
                              <Label text="Departamento:" />
                              <TextField fx:id="txDepartamento" prefHeight="25.0" prefWidth="544.0" promptText="Ex: Computação, Biologia" />
                              <Button fx:id="btnCadastrarProfessor" mnemonicParsing="false" onAction="#cadastrarProfessor" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Cadastrar Professor" />
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="Aluno">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <VBox layoutX="14.0" layoutY="14.0" spacing="15.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
                           <children>
                              <Label text="Nome Completo:" />
                              <TextField fx:id="txNomeAluno" prefHeight="25.0" prefWidth="544.0" />
                              <Label text="Matrícula Acadêmica:" />
                              <TextField fx:id="txMatriculaAluno" prefHeight="25.0" prefWidth="544.0" />
                              <Label text="Curso / Semestre:" />
                              <TextField fx:id="txCursoSemestre" prefHeight="25.0" prefWidth="544.0" promptText="Ex: ADS - 3º Semestre" />
                              <Button fx:id="btnCadastrarAluno" mnemonicParsing="false" onAction="#cadastrarAluno" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Cadastrar Aluno" />
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
      <Button fx:id="btnVoltar" layoutX="14.0" layoutY="375.0" mnemonicParsing="false" onAction="#voltarParaIndex" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #757575; -fx-text-fill: white;" text="Voltar para o Index" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" />
   </children>
</AnchorPane>
